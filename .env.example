# STATE-Bench public-release environment template.
# The canonical evaluation protocol locks the user simulator and judge to GPT-5.4.
# User learning extractors do not need benchmark env vars. Set agent client
# values here for StateBenchAgent, which generates scored test trajectories.

# 1) Locked evaluation client. Required for the user simulator and judge.
# Deployments must point to GPT-5.4 for the locked evaluation protocol.
# Azure OpenAI endpoints are called through the OpenAI v1 API; no api-version is needed.
STATE_BENCH_EVAL_ENDPOINT="https://your-gpt54-resource.openai.azure.com"
STATE_BENCH_EVAL_DEPLOYMENTS="<your gpt 5.4 deployment name>"
# Optional. If omitted, Azure token auth is tried.
# STATE_BENCH_EVAL_API_KEY="<your gpt 5.4 resource api key>"

# 2) Built-in StateBenchAgent client. Required for the default runner path.
# Use any agent deployment/model you want to evaluate.
# Choose Azure OpenAI or OpenAI API settings.

# Azure OpenAI agent client:
# STATE_BENCH_AGENT_ENDPOINT="https://your-agent-resource.openai.azure.com"
# STATE_BENCH_AGENT_DEPLOYMENTS="<your agent deployment name>"
# Optional. If omitted, Azure token auth is tried.
# STATE_BENCH_AGENT_API_KEY="<your agent resource api key>"

# OpenAI API agent client:
# STATE_BENCH_AGENT_PROVIDER="openai"
# STATE_BENCH_AGENT_MODEL="<your OpenAI model>"
# STATE_BENCH_AGENT_API_KEY="<your OpenAI API key>"
# OPENAI_API_KEY is also accepted as a fallback.

# 3) Role- and domain-isolated Mubit instances.
# Every uncommented API key and its underlying Mubit instance must be unique.
# Hosted mbt_<instance>_... keys expose the non-secret instance segment for
# validation. For legacy/non-hosted keys, also set the matching *_INSTANCE_ID.
# There is deliberately no fallback to MUBIT_API_KEY or a shared key.
MUBIT_STATE_BENCH_SMOKE_TRAVEL_API_KEY=mbt_statebench-travel-smoke-zmf655_5a7c51b2aff44337_1dde21b8999a45cb859d85dbcdd280f28739ca6b308244bb9891c7f23e0edbdc
MUBIT_STATE_BENCH_BUILD_TRAVEL_API_KEY=mbt_statebench-travel-build-pd0p9l_b7c533f8325f40e9_4e8720e9c752474cab29acc207a55c827b29c6cf05ed428aa4ffb36475f1ada0
MUBIT_STATE_BENCH_EVAL_TRAVEL_API_KEY=mbt_statebench-travel-eval-pdi5oy_8710afac24df4539_adb47a898fd84952b161a1cc00fe72878702d29286ad43e48cc145b140b0627c
# MUBIT_STATE_BENCH_SMOKE_CUSTOMER_SUPPORT_API_KEY="mbt_..."
# MUBIT_STATE_BENCH_BUILD_CUSTOMER_SUPPORT_API_KEY="mbt_..."
# MUBIT_STATE_BENCH_EVAL_CUSTOMER_SUPPORT_API_KEY="mbt_..."
# MUBIT_STATE_BENCH_SMOKE_SHOPPING_ASSISTANT_API_KEY="mbt_..."
# MUBIT_STATE_BENCH_BUILD_SHOPPING_ASSISTANT_API_KEY="mbt_..."
# MUBIT_STATE_BENCH_EVAL_SHOPPING_ASSISTANT_API_KEY="mbt_..."
# MUBIT_STATE_BENCH_BUILD_TRAVEL_INSTANCE_ID="<non-secret instance id; legacy keys only>"
# Optional endpoint overrides follow the same role/domain naming convention:
MUBIT_STATE_BENCH_BUILD_TRAVEL_ENDPOINT="https://api.mubit.ai"
# MUBIT_STATE_BENCH_TRANSPORT="auto"
# MUBIT_STATE_BENCH_NAMESPACE="statebench"
# MUBIT_STATE_BENCH_BUDGET="mid"
# MUBIT_STATE_BENCH_RANK_BY="relevance"

# 4) Required identity for an EVAL run and its separate retrieval telemetry.
# MUBIT_STATE_BENCH_EXPERIMENT_ID="phase2-travel-eval-001"
# MUBIT_STATE_BENCH_ARM="mubit"
# MUBIT_STATE_BENCH_EVAL_ARTIFACT_SHA256="<64 lowercase hex characters>"
# MUBIT_STATE_BENCH_EVAL_LESSON_SET_SHA256="<64 lowercase hex characters>"
# Fallback only for direct orchestrator calls; standard CLIs supply run_idx.
# MUBIT_STATE_BENCH_RUN_NUMBER="1"
